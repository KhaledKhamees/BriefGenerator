@model BriefGenerator.Web.Models.PublicBriefViewModel

@{
    ViewData["Title"] = "Review Your Brief";
    Layout = null;
    var s = Model.Structured;
    var projectTitle = s?.ProjectName ?? "Project Brief";
    var isConfirmed = Model.Brief?.Status == "confirmed";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@projectTitle — BriefGen</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ── Chat panel ── */
        .chat-panel {
            display: flex;
            flex-direction: column;
            height: 540px;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0,0,0,0.10);
            background: #fff;
        }
        .chat-header {
            background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
            color: #fff;
            padding: 1rem 1.25rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex-shrink: 0;
        }
        .ai-dot {
            width: 10px; height: 10px;
            background: #4ade80;
            border-radius: 50%;
            display: inline-block;
            animation: ai-pulse 1.8s infinite;
        }
        @@keyframes ai-pulse {
            0%, 100% { opacity: 1; }
            50%       { opacity: 0.4; }
        }
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            background: #f8f9fb;
        }
        .bubble {
            max-width: 78%;
            padding: 0.65rem 1rem;
            border-radius: 18px;
            font-size: 0.92rem;
            line-height: 1.55;
            word-break: break-word;
        }
        .bubble-ai {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-bottom-left-radius: 4px;
            align-self: flex-start;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        }
        .bubble-user {
            background: linear-gradient(135deg, #0d6efd, #6610f2);
            color: #fff;
            border-bottom-right-radius: 4px;
            align-self: flex-end;
        }
        .bubble-label {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 3px;
            color: #94a3b8;
        }
        .bubble-label.user-label { text-align: right; color: #a5b4fc; }

        /* Typing indicator */
        .typing-indicator {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 0.65rem 1rem;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            border-bottom-left-radius: 4px;
            align-self: flex-start;
            width: fit-content;
        }
        .typing-dot {
            width: 7px; height: 7px;
            background: #94a3b8;
            border-radius: 50%;
            animation: bounce-dot 1.2s infinite;
        }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes bounce-dot {
            0%, 80%, 100% { transform: translateY(0); }
            40%            { transform: translateY(-6px); }
        }

        /* Input row */
        .chat-input-row {
            display: flex;
            gap: 0.5rem;
            padding: 0.85rem 1rem;
            background: #fff;
            border-top: 1px solid #e9ecef;
            flex-shrink: 0;
        }
        .chat-input-row textarea {
            flex: 1;
            border-radius: 12px;
            border: 1.5px solid #dee2e6;
            padding: 0.6rem 0.9rem;
            font-size: 0.92rem;
            resize: none;
            font-family: inherit;
            transition: border-color 0.15s;
            max-height: 120px;
            line-height: 1.5;
        }
        .chat-input-row textarea:focus {
            outline: none;
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.12);
        }
        .chat-send-btn {
            width: 44px; height: 44px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #0d6efd, #6610f2);
            color: #fff;
            font-size: 1.1rem;
            cursor: pointer;
            flex-shrink: 0;
            align-self: flex-end;
            transition: opacity 0.15s, transform 0.1s;
            display: flex; align-items: center; justify-content: center;
        }
        .chat-send-btn:hover  { opacity: 0.88; }
        .chat-send-btn:active { transform: scale(0.95); }
        .chat-send-btn:disabled { opacity: 0.45; cursor: not-allowed; }

        /* Field-update toast */
        .field-toast {
            background: #d1fae5;
            border: 1px solid #6ee7b7;
            border-radius: 10px;
            padding: 0.5rem 0.9rem;
            font-size: 0.8rem;
            color: #065f46;
            align-self: center;
            font-weight: 500;
        }

        /* Confirm bar */
        .confirm-bar {
            background: #fff;
            border-top: 1px solid #e9ecef;
            padding: 1rem 1.25rem;
            text-align: center;
            border-radius: 0 0 16px 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.10);
        }

        /* Sticky brief column */
        .brief-col { position: sticky; top: 1rem; }

        @@media (max-width: 991px) {
            .brief-col { position: static; }
            .chat-panel { height: 460px; }
        }
    </style>
</head>
<body style="background:#f4f6f9; min-height:100vh;">

    <!-- ── Page header ── -->
    <div class="public-header">
        <div class="container-lg px-3">
            <div class="small mb-2 opacity-75">BriefGen — Project Brief Review</div>
            <h1 class="fw-bold mb-1 fs-3">@projectTitle</h1>
            @if (!string.IsNullOrWhiteSpace(s?.ClientName))
            {
                <p class="mb-0 opacity-90 small">Prepared for: <strong>@s.ClientName</strong></p>
            }
            <div class="mt-3">
                <span class="badge bg-white fw-semibold px-3 py-2 @(isConfirmed ? "text-success" : "text-primary")">
                    @(isConfirmed ? "✅ Confirmed" : "📋 Awaiting Your Review")
                </span>
            </div>
        </div>
    </div>

    <div class="container-lg px-3 pb-5">

        @if (isConfirmed)
        {
            <div class="alert alert-success fw-semibold mt-3">
                ✅ You have already confirmed this brief. Thank you!
            </div>
        }

        <div class="row g-4 mt-0">

            <!-- ── Left: Brief content ── -->
            <div class="col-lg-5">
                <div class="brief-col">
                    <h6 class="text-muted fw-semibold mb-3 small text-uppercase">Your Project Brief</h6>

                    @if (s != null)
                    {
                        @if (!string.IsNullOrWhiteSpace(s.BusinessGoal))
                        {
                            <div class="brief-section mb-2">
                                <h6>🎯 Business Goal</h6>
                                <p class="mb-0">@s.BusinessGoal</p>
                            </div>
                        }
                        @if (s.TargetUsers?.Any() == true)
                        {
                            <div class="brief-section mb-2">
                                <h6>👥 Target Users</h6>
                                <div>@foreach (var u in s.TargetUsers) { <span class="tag-pill">@u</span> }</div>
                            </div>
                        }
                        @if (s.Features?.Any() == true)
                        {
                            <div class="brief-section mb-2">
                                <h6>⚙️ Features</h6>
                                <ul class="mb-0">@foreach (var f in s.Features) { <li>@f</li> }</ul>
                            </div>
                        }
                        @if (s.Platforms?.Any() == true)
                        {
                            <div class="brief-section mb-2">
                                <h6>🖥️ Platforms</h6>
                                <div>@foreach (var p in s.Platforms) { <span class="tag-pill">@p</span> }</div>
                            </div>
                        }
                        @if (s.DesignRequirements?.Any() == true)
                        {
                            <div class="brief-section mb-2">
                                <h6>🎨 Design Requirements</h6>
                                <ul class="mb-0">@foreach (var d in s.DesignRequirements) { <li>@d</li> }</ul>
                            </div>
                        }
                        @if (s.TechnicalConstraints?.Any() == true)
                        {
                            <div class="brief-section mb-2">
                                <h6>🔧 Technical Constraints</h6>
                                <ul class="mb-0">@foreach (var t in s.TechnicalConstraints) { <li>@t</li> }</ul>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(s.Timeline) || !string.IsNullOrWhiteSpace(s.Budget))
                        {
                            <div class="brief-section mb-2">
                                <div class="row g-2">
                                    @if (!string.IsNullOrWhiteSpace(s.Timeline))
                                    {
                                        <div class="col-6"><h6>📅 Timeline</h6><p class="mb-0">@s.Timeline</p></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(s.Budget))
                                    {
                                        <div class="col-6"><h6>💰 Budget</h6><p class="mb-0">@s.Budget</p></div>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <!-- Missing fields indicator -->
                    @if (Model.MissingFields.Any() && !isConfirmed)
                    {
                        <div class="brief-section warning mt-2" id="missingSection">
                            <h6>⚠️ Questions for You</h6>
                            <ul class="mb-0 list-unstyled">
                                @foreach (var f in Model.MissingFields)
                                {
                                    var display = f.Contains(' ') ? f
                                        : System.Globalization.CultureInfo.CurrentCulture.TextInfo
                                            .ToTitleCase(f.Replace("_", " "));
                                    <li class="py-1 border-bottom small">
                                        <span class="text-warning me-1">●</span>@display
                                    </li>
                                }
                            </ul>
                            <p class="small text-muted mt-2 mb-0">Chat with the AI assistant to answer these →</p>
                        </div>
                    }
                </div>
            </div>

            <!-- ── Right: Chat panel ── -->
            <div class="col-lg-7">
                @if (!isConfirmed)
                {
                    <div class="chat-panel" id="chatPanel">
                        <div class="chat-header">
                            <span class="ai-dot"></span>
                            <span>BriefGen AI Assistant</span>
                            <span class="ms-auto small opacity-75 fw-normal">Ask me anything about your brief</span>
                        </div>

                        <div class="chat-messages" id="chatMessages">
                            <!-- Opening message: replaced by AI greeting on load -->
                            <div id="greetingWrapper" style="display:flex;flex-direction:column;align-items:flex-start;">
                                <div class="bubble-label">BriefGen AI</div>
                                <div class="typing-indicator" id="greetingTyping">
                                    <div class="typing-dot"></div>
                                    <div class="typing-dot"></div>
                                    <div class="typing-dot"></div>
                                </div>
                            </div>
                        </div>

                        <div class="chat-input-row">
                            <textarea id="chatInput" rows="1" placeholder="Type your message… (Enter to send, Shift+Enter for new line)"></textarea>
                            <button class="chat-send-btn" id="sendBtn" title="Send">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Confirm bar sits flush below the chat panel -->
                    <div class="confirm-bar">
                        <p class="text-muted small mb-2">Happy with everything? Confirm the brief to let the team proceed.</p>
                        <form method="post" action="/brief/@Model.Token/confirm" id="confirmForm">
                            <button type="submit" class="btn btn-success px-5 fw-semibold" id="confirmBtn">
                                ✅ Confirm Brief
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="card text-center py-5">
                        <div class="card-body">
                            <div style="font-size:3rem">🎉</div>
                            <h4 class="fw-bold mt-3">Brief Confirmed!</h4>
                            <p class="text-muted">The team has been notified and will be in touch soon.</p>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>

    <footer class="text-center py-4 text-muted small border-top mt-4">
        Powered by <strong>BriefGen</strong> — AI-Powered Project Briefs
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const TOKEN        = '@Model.Token';
        const CHAT_URL     = `/brief/${TOKEN}/chat`;
        const GREETING_URL = `/brief/${TOKEN}/chat/greeting`;

        const history    = [];
        const messagesEl = document.getElementById('chatMessages');
        const inputEl    = document.getElementById('chatInput');
        const sendBtn    = document.getElementById('sendBtn');

        // ── Load greeting ─────────────────────────────────────────────────
        async function loadGreeting() {
            try {
                const res  = await fetch(GREETING_URL);
                const data = JSON.parse(await res.text());
                const greeting = (data.greeting ?? '').trim();
                const wrapper = document.getElementById('greetingWrapper');
                if (wrapper) {
                    wrapper.innerHTML = `
                        <div class="bubble-label">BriefGen AI</div>
                        <div class="bubble bubble-ai">${escapeHtml(greeting).replace(/\n/g, '<br>')}</div>`;
                }
                if (greeting) history.push({ role: 'assistant', content: greeting });
            } catch {
                const wrapper = document.getElementById('greetingWrapper');
                if (wrapper) wrapper.innerHTML = `
                    <div class="bubble-label">BriefGen AI</div>
                    <div class="bubble bubble-ai">Hi! 👋 I've reviewed your project brief. Feel free to ask me anything or let me know what you'd like to change.</div>`;
            }
            setLoading(false);
        }

        setLoading(true);
        loadGreeting();

        // ── Input events ──────────────────────────────────────────────────
        inputEl?.addEventListener('input', () => {
            inputEl.style.height = 'auto';
            inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px';
        });
        inputEl?.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });
        sendBtn?.addEventListener('click', sendMessage);

        // ── Send ──────────────────────────────────────────────────────────
        async function sendMessage() {
            const text = inputEl.value.trim();
            if (!text || sendBtn.disabled) return;

            appendBubble('user', text);
            history.push({ role: 'user', content: text });
            inputEl.value = '';
            inputEl.style.height = 'auto';
            setLoading(true);

            let typingId = null;
            try {
                typingId = showTyping();

                const res = await fetch(CHAT_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text, history: history.slice(0, -1) })
                });

                removeTyping(typingId); typingId = null;

                const rawBody = await res.text();
                console.log('[Chat]', res.status, rawBody);

                if (!res.ok) {
                    let msg = `⚠️ Error ${res.status}. Please try again.`;
                    try { const e = JSON.parse(rawBody); if (e.error) msg = `⚠️ ${e.error}`; } catch {}
                    appendBubble('ai', msg);
                    setLoading(false); inputEl.focus(); return;
                }

                const data = JSON.parse(rawBody);
                const reply = (data.reply ?? '').trim();
                if (reply) {
                    appendBubble('ai', reply);
                    history.push({ role: 'assistant', content: reply });
                }

                // Show a small toast when a field is saved — no strikethrough, no tracking
                if (data.fieldUpdated && data.fieldValue) {
                    const label = data.fieldUpdated.replace(/_/g, ' ')
                        .replace(/\b\w/g, c => c.toUpperCase());
                    appendFieldToast(label, data.fieldValue);
                }

            } catch (err) {
                if (typingId) removeTyping(typingId);
                appendBubble('ai', `⚠️ Network error: ${err.message}`);
            }

            setLoading(false);
            inputEl.focus();
        }

        // ── Helpers ───────────────────────────────────────────────────────
        function appendBubble(role, text) {
            const isUser = role === 'user';
            const wrapper = document.createElement('div');
            wrapper.style.cssText = `display:flex;flex-direction:column;align-items:${isUser ? 'flex-end' : 'flex-start'};`;
            const label = document.createElement('div');
            label.className = 'bubble-label' + (isUser ? ' user-label' : '');
            label.textContent = isUser ? 'You' : 'BriefGen AI';
            const bubble = document.createElement('div');
            bubble.className = 'bubble ' + (isUser ? 'bubble-user' : 'bubble-ai');
            bubble.innerHTML = escapeHtml(text).replace(/\n/g, '<br>');
            wrapper.appendChild(label);
            wrapper.appendChild(bubble);
            messagesEl.appendChild(wrapper);
            scrollToBottom();
        }

        function appendFieldToast(label, value) {
            const toast = document.createElement('div');
            toast.className = 'field-toast';
            toast.textContent = `✅ Saved: ${label} → "${value}"`;
            messagesEl.appendChild(toast);
            scrollToBottom();
        }

        function showTyping() {
            const id = 'typing-' + Date.now();
            const w = document.createElement('div');
            w.id = id;
            w.style.cssText = 'display:flex;flex-direction:column;align-items:flex-start;';
            w.innerHTML = `<div class="bubble-label">BriefGen AI</div>
                <div class="typing-indicator">
                    <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
                </div>`;
            messagesEl.appendChild(w);
            scrollToBottom();
            return id;
        }

        function removeTyping(id) { document.getElementById(id)?.remove(); }
        function setLoading(on) { if (sendBtn) sendBtn.disabled = on; if (inputEl) inputEl.disabled = on; }
        function scrollToBottom() { messagesEl.scrollTop = messagesEl.scrollHeight; }
        function escapeHtml(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        document.getElementById('confirmForm')?.addEventListener('submit', () => {
            const btn = document.getElementById('confirmBtn');
            if (btn) { btn.disabled = true; btn.textContent = 'Confirming…'; }
        });
    </script>
</body>
</html>
