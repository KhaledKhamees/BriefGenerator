@model BriefGenerator.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account — BriefGen</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { background: #f4f6f9; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem 0; }
        .auth-card { width: 100%; max-width: 440px; }
        .auth-logo { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.5px; }
        .auth-logo span { color: #0d6efd; }
        .divider { display: flex; align-items: center; gap: 0.75rem; color: #adb5bd; font-size: 0.82rem; }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #dee2e6; }
        .password-strength { height: 4px; border-radius: 2px; transition: width 0.3s, background 0.3s; }
    </style>
</head>
<body>
    <div class="auth-card px-3">
        <div class="text-center mb-4">
            <div class="auth-logo"><span>Brief</span>Gen</div>
            <p class="text-muted mt-1 small">AI-Powered Project Briefs</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-1">Create your account</h4>
                <p class="text-muted small mb-4">Start generating AI-powered project briefs.</p>

                <form asp-action="Register" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold small">Full name</label>
                        <input asp-for="Name" class="form-control" placeholder="Jane Smith" autocomplete="name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small">Work email</label>
                        <input asp-for="Email" class="form-control" placeholder="you@company.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small">Password</label>
                        <input asp-for="Password" class="form-control" id="passwordInput"
                               placeholder="Min. 8 characters" autocomplete="new-password" />
                        <div class="mt-2 bg-light rounded" style="height:4px;">
                            <div id="strengthBar" class="password-strength" style="width:0%;background:#dc3545;"></div>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm password</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Create Account</button>
                </form>

                <div class="divider my-4">or</div>

                <p class="text-center small mb-0">
                    Already have an account?
                    <a asp-action="Login" asp-controller="Account" class="fw-semibold text-decoration-none">Sign in</a>
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Simple password strength indicator
        document.getElementById('passwordInput')?.addEventListener('input', function () {
            const val = this.value;
            const bar = document.getElementById('strengthBar');
            let strength = 0;
            if (val.length >= 8) strength++;
            if (/[A-Z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            const widths  = ['0%', '25%', '50%', '75%', '100%'];
            const colors  = ['#dc3545', '#dc3545', '#ffc107', '#0d6efd', '#198754'];
            bar.style.width      = widths[strength];
            bar.style.background = colors[strength];
        });
    </script>
</body>
</html>
