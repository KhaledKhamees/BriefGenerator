@model BriefGenerator.Web.Models.BriefDto

@{
    ViewData["Title"] = "Brief Details";
}

<div class="container mt-4">
    <h2>Brief Details (@Model.Id.ToString().Substring(0, 8))</h2>
    <div class="mb-3">
        <span class="badge bg-info text-dark">Status: @Model.Status</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.StructuredJson))
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light">
                <h4 class="mb-0">Structured Brief Data</h4>
            </div>
            <div class="card-body bg-light">
                <pre><code>@Model.StructuredJson</code></pre>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MarkdownOutput))
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light">
                <h4 class="mb-0">Markdown Output</h4>
            </div>
            <div class="card-body">
                <pre style="white-space: pre-wrap;">@Model.MarkdownOutput</pre>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MissingFieldsJson))
    {
        <div class="card mb-4 shadow-sm border-warning">
            <div class="card-header bg-warning">
                <h4 class="mb-0">Missing Information Identified</h4>
            </div>
            <div class="card-body">
                <pre><code>@Model.MissingFieldsJson</code></pre>
            </div>
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>